# =============================================================================
# Hermes – Environment variables
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ── MariaDB ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_pw

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=hermes_db
DB_USER=hermes
DB_PASSWORD=change_me_db_pw

# ── SMTP (leave blank to disable email sending) ───────────────────────────────
# Jednotný zdroj pre PHP web aj C++ billing_reminder (config/config.json smtp môže byť prázdne).
# Gmail example: use an App Password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=billing@yourdomain.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=billing@yourdomain.com
SMTP_FROM_NAME=Fakturacne oddelenie
SMTP_TLS=true

# ── Bankové AIS (SBAS / PSD2) ─────────────────────────────────────────────────
# Verejná URL webu (bez koncového /) – musí sedieť s redirect URI v registrácii TPP u banky.
HERMES_PUBLIC_URL=http://localhost:8080
# Kľúč na šifrovanie OAuth tokenov v MariaDB (dlhý náhodný reťazec).
HERMES_BANK_TOKEN_KEY=KhqALyIwl3dD9YK3XklyWGhEjUC0PKM+PLoYbc
# Cesta k JSON (v Dockeri často /etc/hermes/sbas.json).
HERMES_SBAS_CONFIG=
# Tajomstvo klienta ak ho nechcete mať v sbas.json (prepíše oauth.client_secret).
SBAS_CLIENT_SECRET=
# 1 = vynútiť mock transakcie z config/sbas.json (iba riadky s mock účtom).
SBAS_USE_MOCK=

# ── Mock Bank server (lokálny kontajner) ─────────────────────────────────────
# Hermes Mock Bank beží na porte 8082. Stačí vybrať "Hermes Mock Bank (lokálna)"
# na stránke Banka → OAuth. Nepotrebuje client_id ani secret.

# ── Sandbox Tatra banka (voliteľné) ──────────────────────────────────────────
# 1. Registrujte sa na https://developer.tatrabanka.sk/
# 2. Vytvorte aplikáciu → získate client_id a client_secret
# 3. Nastavte redirect URI: http://localhost:8080/index.php?page=bank_oauth
# 4. Vyplňte:
# SBAS_CLIENT_SECRET=váš_tatra_sandbox_secret
# A v config/sbas.json nastavte oauth.client_id na váš sandbox client_id.
# 5. Na stránke Banka vyberte "Tatra banka" a kliknite Prepojiť (OAuth).
